## Copy to .env and fill in your Postgres credentials or set DATABASE_URL
# Example DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

PG_USER=your_pg_user
PG_PWD=your_pg_password
PG_HOST=localhost
PG_PORT=5432
PG_DB=your_database_name

# Alternatively set DATABASE_URL for Render / production
# DATABASE_URL=postgresql://user:password@host:5432/dbname

STATIC=../proto/dist
