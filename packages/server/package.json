{
  "name": "server",
  "version": "1.0.0",
  "description": "Express + TypeScript backend using PostgreSQL (pg)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
  "build": "tsc",
    "start": "npm run build && npm run start:node",
